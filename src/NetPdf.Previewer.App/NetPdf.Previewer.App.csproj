<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One target only. net8.0 + RollForward=Major runs on the .NET 8, 9, 10 and 11 runtimes.
         Several targets would repeat the big native files and push the package over nuget.org's 250 MB limit. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netpdf-previewer</ToolCommandName>
    <PackageId>NetPdfKit.Previewer.App</PackageId>
    <Description>Live PDF previewer window for NetPdfKit — receives documents pushed by NetPdfKit.Previewer's ShowInPreviewer().</Description>
    <PackageTags>pdf;preview;hot-reload;netpdf;dotnet-tool</PackageTags>
    <Authors>Ssewannonda Keith Edwin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/edcsu/netpdf</RepositoryUrl>
    <PackageProjectUrl>https://edcsu.github.io/netpdf/</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/edcsu/netpdf/releases</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RollForward>Major</RollForward>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Desktop-only app; PDFium rendering supports all desktop targets. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetPdf/NetPdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- Avalonia.Skia pulls the old SkiaSharp.NativeAssets.Linux 2.88.9, whose
         native libSkiaSharp.so (v88.1) conflicts with the SkiaSharp 3.119 that
         NetPdf's PDFtoImage/Svg.Skia use. Pin the Linux native to 3.119 so it
         matches the managed SkiaSharp and the Win/macOS natives (which are
         already 3.119). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
  </ItemGroup>

  <!-- Native .pdb files from SkiaSharp/HarfBuzz are huge (about 80 MB each) and useless to tool users. -->
  <Target Name="DropNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('runtimes'))" />
    </ItemGroup>
  </Target>

</Project>
