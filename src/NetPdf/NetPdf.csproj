<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetPdfKit.Core</PackageId>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Ssewannonda Keith Edwin</Authors>
    <Description>Create, view, and manage PDF files with one fluent API. Lean core without image, SVG or barcode dependencies; add NetPdfKit.Svg, NetPdfKit.Barcodes or NetPdfKit.Rendering as needed, or install NetPdfKit for everything.</Description>
    <PackageTags>pdf;create;merge;split;extract;render</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/edcsu/netpdf</RepositoryUrl>
    <PackageProjectUrl>https://edcsu.github.io/netpdf/</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/edcsu/netpdf/releases</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Creation/Fonts/*.ttf" LogicalName="NetPdf.Fonts.%(Filename)%(Extension)" />
    <None Include="Creation/Fonts/LICENSE-LiberationFonts.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetPdf.Tests" />
    <InternalsVisibleTo Include="NetPdf.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

</Project>
